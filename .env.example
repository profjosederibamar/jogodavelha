# Supabase configuration for online multiplayer, scores, and match history
# Obtenha em https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Vercel & GitHub repository URL (opcional para exibição de status e links)
VITE_GITHUB_REPO="https://github.com/seu-usuario/jogo-da-velha"
VITE_VERCEL_PROJECT_URL=""
